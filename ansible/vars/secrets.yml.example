---
# Copy this file to secrets.yml, fill in the real values, then encrypt:
#   ansible-vault encrypt vars/secrets.yml

zerotier_ip: "10.250.163.x"

# API keys for LLM providers (set active_provider in vars/main.yml to switch)
deepseek_api_key: "sk-your-deepseek-api-key"
minimax_api_key: "your-minimax-api-key"

matrix_password: "your-matrix-password"
matrix_recovery_key: "your-matrix-recovery-key"
matrix_home_room: "!roomid:matrix.org"
matrix_home_room_root: "!roomid:matrix.org"
matrix_user_id: "@your-bot:matrix.org"
matrix_allowed_users: "@your-user:matrix.org"

# Optional: provide a static access token for grocery as fallback (used if password login fails).
# matrix_access_token: "syt_..."

# Dashboard basic auth (for non-loopback bind)
dashboard_basic_auth_password: "choose-a-strong-password"
dashboard_basic_auth_secret: "openssl rand -base64 32"

# GitHub App (rafaelhdr-bot) credentials for gh CLI authentication.
# App ID is the integer shown on the App settings page.
# Private key is the PEM file downloaded from the App settings page.
# To encrypt after filling in: ansible-vault encrypt vars/secrets.yml
github_app_id: "123456"
github_app_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  your-private-key-content-here
  -----END RSA PRIVATE KEY-----
