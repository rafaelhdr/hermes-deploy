---
# Copy this file to secrets.yml, fill in the real values, then encrypt:
#   ansible-vault encrypt vars/secrets.yml

zerotier_ip: "10.250.163.x"

deepseek_api_key: "sk-your-deepseek-api-key"

matrix_password: "your-matrix-password"
matrix_recovery_key: "your-matrix-recovery-key"
matrix_home_room: "!roomid:matrix.org"
matrix_user_id: "@your-bot:matrix.org"
matrix_allowed_users: "@your-user:matrix.org"

# Optional: provide an access token directly instead of a password.
# If both are set, password login is attempted first.
# matrix_access_token: "syt_..."

# Dashboard basic auth (for non-loopback bind)
dashboard_basic_auth_password: "choose-a-strong-password"
dashboard_basic_auth_secret: "openssl rand -base64 32"
